<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Guru - Sistem Ujian Online TKJ</title>
  <!-- Tailwind CSS untuk Tampilan Modern -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- SheetJS untuk Parsing File Excel -->
  <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>
</head>
<body class="bg-slate-100 font-sans min-h-screen text-slate-800">

  <!-- ================= 1. HALAMAN LOGIN GURU ================= -->
  <div id="loginSection" class="min-h-screen flex items-center justify-center p-4">
    <div class="bg-white p-8 rounded-xl shadow-lg w-full max-w-md">
      <div class="text-center mb-6">
        <h2 class="text-2xl font-bold text-slate-800">Login Guru TKJ</h2>
        <p class="text-xs text-slate-500 mt-1">Sistem Pembuat & Kelola Ujian Online</p>
      </div>

      <div class="space-y-4">
        <div>
          <label class="block font-semibold mb-1 text-sm">Username</label>
          <input type="text" id="username" placeholder="Masukkan username" class="w-full p-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        <div>
          <label class="block font-semibold mb-1 text-sm">Password</label>
          <input type="password" id="password" placeholder="Masukkan password" class="w-full p-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        <button onclick="login()" id="btnLogin" class="w-full bg-blue-600 text-white font-semibold py-3 rounded-lg hover:bg-blue-700 transition">
          Masuk
        </button>
      </div>
    </div>
  </div>

  <!-- ================= 2. DASHBOARD BUAT UJIAN ================= -->
  <div id="dashboardSection" class="hidden p-4 md:p-8 max-w-4xl mx-auto space-y-6">
    <!-- Header Dashboard -->
    <div class="flex justify-between items-center bg-white p-6 rounded-xl shadow">
      <div>
        <h1 class="text-2xl font-bold text-slate-800">Dashboard Guru</h1>
        <p class="text-sm text-slate-500" id="welcomeText">Selamat datang, Guru TKJ</p>
      </div>
      <button onclick="logout()" class="text-sm bg-slate-200 text-slate-700 px-4 py-2 rounded-lg hover:bg-slate-300 font-medium">
        Keluar
      </button>
    </div>

    <!-- Form Pengaturan Ujian -->
    <div class="bg-white p-6 rounded-xl shadow space-y-4">
      <h2 class="text-lg font-bold text-slate-700 border-b pb-2">1. Pengaturan Ujian</h2>
      
      <div>
        <label class="block font-semibold mb-1 text-sm">Nama Ujian / Mata Pelajaran</label>
        <input type="text" id="namaUjian" placeholder="Contoh: Penilaian Akhir Semester - Administrasi Jaringan" class="w-full p-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label class="block font-semibold mb-1 text-sm">Durasi Ujian (Menit)</label>
          <input type="number" id="durasi" value="60" min="5" class="w-full p-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        <div class="flex items-center space-x-2 pt-6">
          <input type="checkbox" id="acakSoal" class="w-5 h-5 text-blue-600 rounded">
          <label for="acakSoal" class="font-medium text-sm">Acak Urutan Soal</label>
        </div>
        <div class="flex items-center space-x-2 pt-6">
          <input type="checkbox" id="acakJawaban" class="w-5 h-5 text-blue-600 rounded">
          <label for="acakJawaban" class="font-medium text-sm">Acak Opsi Jawaban (A-E)</label>
        </div>
      </div>
    </div>

    <!-- Form Upload File Excel -->
    <div class="bg-white p-6 rounded-xl shadow space-y-4">
      <h2 class="text-lg font-bold text-slate-700 border-b pb-2">2. Upload Data Soal & Peserta (.xlsx)</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Excel Peserta -->
        <div class="p-4 border-2 border-dashed rounded-lg bg-slate-50 space-y-2">
          <label class="block font-semibold text-sm">File Peserta Ujian</label>
          <input type="file" id="excelPeserta" accept=".xlsx, .xls" class="block w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
          <p id="statusPeserta" class="text-xs text-slate-500">Belum ada file dipilih.</p>
        </div>
        
        <!-- Excel Soal -->
        <div class="p-4 border-2 border-dashed rounded-lg bg-slate-50 space-y-2">
          <label class="block font-semibold text-sm">File Bank Soal</label>
          <input type="file" id="excelSoal" accept=".xlsx, .xls" class="block w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
          <p id="statusSoal" class="text-xs text-slate-500">Belum ada file dipilih.</p>
        </div>
      </div>
    </div>

    <!-- Tombol Submit & Indikator Loading -->
    <div class="flex items-center justify-between">
      <button onclick="simpanUjian()" id="btnGenerate" class="bg-green-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-green-700 transition shadow">
        Generate Link Ujian
      </button>

      <div id="loadingIndicator" class="hidden flex items-center space-x-3 text-blue-600">
        <svg class="animate-spin h-5 w-5" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span class="text-sm font-medium">Membuat Spreadsheet baru di Google Drive...</span>
      </div>
    </div>

    <!-- Output Tautan Hasil -->
    <div id="resultLink" class="hidden p-6 bg-green-50 border border-green-300 rounded-xl space-y-4 shadow-sm">
      <div class="flex items-center space-x-2 text-green-800">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
        <h3 class="font-bold text-lg">Spreadsheet & Link Ujian Berhasil Dibuat!</h3>
      </div>

      <div class="space-y-3">
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">Link Ujian untuk Dibagikan ke Siswa:</label>
          <div class="flex space-x-2">
            <input type="text" id="generatedUrl" readonly class="w-full p-3 bg-white border rounded-lg text-sm font-mono text-slate-700 focus:outline-none">
            <button onclick="copyLink()" class="bg-blue-600 text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-blue-700">
              Salin
            </button>
          </div>
        </div>

        <div class="pt-2">
          <a id="driveSheetUrl" href="#" target="_blank" class="inline-flex items-center space-x-2 bg-green-600 text-white text-sm px-5 py-3 rounded-lg font-semibold hover:bg-green-700 transition">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V4z"></path>
            </svg>
            <span>Buka Spreadsheet Ujian di Google Drive</span>
          </a>
        </div>
      </div>
    </div>

  </div>

  <!-- ================= 3. SCRIPT LOGIKA FRONTEND ================= -->
  <script>
    // GANTI DENGAN URL GOOGLE APPS SCRIPT ANDA
    const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbxv04CGYndnIapm0PaVElRzGSre-Q3TJaoeiHIE7wBgb_LcVVkgQbFUtyHOiXb1fnHt/exec";

    let dataPeserta = [];
    let dataSoal = [];

    // Fungsi Login
    async function login() {
      const u = document.getElementById('username').value.trim();
      const p = document.getElementById('password').value.trim();

      if (!u || !p) return alert("Username dan Password tidak boleh kosong!");

      document.getElementById('btnLogin').innerText = "Memeriksa...";

      try {
        const res = await fetch(SCRIPT_URL, {
          method: "POST",
          body: JSON.stringify({ action: "login", username: u, password: p })
        });
        const data = await res.json();

        if (data.status === "success") {
          document.getElementById('loginSection').classList.add('hidden');
          document.getElementById('dashboardSection').classList.remove('hidden');
          document.getElementById('welcomeText').innerText = `Selamat datang, ${data.nama || 'Guru TKJ'}`;
        } else {
          alert(data.message || "Username atau Password salah!");
        }
      } catch (err) {
        alert("Gagal terhubung ke Google Apps Script backend!");
      } finally {
        document.getElementById('btnLogin').innerText = "Masuk";
      }
    }

    function logout() {
      window.location.reload();
    }

    // Listener Pengunggah File Excel
    document.getElementById('excelPeserta').addEventListener('change', (e) => {
      parseExcel(e, (data) => {
        dataPeserta = data;
        document.getElementById('statusPeserta').innerText = `✅ Terbaca ${data.length} peserta.`;
        document.getElementById('statusPeserta').classList.add('text-green-600');
      });
    });

    document.getElementById('excelSoal').addEventListener('change', (e) => {
      parseExcel(e, (data) => {
        dataSoal = data;
        document.getElementById('statusSoal').innerText = `✅ Terbaca ${data.length} soal.`;
        document.getElementById('statusSoal').classList.add('text-green-600');
      });
    });

    // Fungsi Parsing Excel menggunakan SheetJS
    function parseExcel(e, callback) {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (evt) => {
        try {
          const wb = XLSX.read(evt.target.result, { type: 'binary' });
          const sheetName = wb.SheetNames[0];
          const sheet = wb.Sheets[sheetName];
          const jsonData = XLSX.utils.sheet_to_json(sheet);
          callback(jsonData);
        } catch (err) {
          alert("Gagal membaca file Excel. Pastikan format file sesuai!");
        }
      };
      reader.readAsBinaryString(file);
    }

    // Fungsi Simpan Ujian & Request Pembuatan Sheet Baru
    async function simpanUjian() {
      const namaUjian = document.getElementById('namaUjian').value.trim();
      const durasi = document.getElementById('durasi').value;

      if (!namaUjian) return alert("Nama Ujian wajib diisi!");
      if (dataPeserta.length === 0) return alert("Harap unggah file Excel Peserta!");
      if (dataSoal.length === 0) return alert("Harap unggah file Excel Soal!");

      // Tampilkan Indikator Loading
      document.getElementById('loadingIndicator').classList.remove('hidden');
      document.getElementById('btnGenerate').disabled = true;
      document.getElementById('btnGenerate').classList.add('opacity-50');

      const payload = {
        action: "simpanUjian",
        namaUjian: namaUjian,
        durasi: durasi,
        acakSoal: document.getElementById('acakSoal').checked,
        acakJawaban: document.getElementById('acakJawaban').checked,
        peserta: dataPeserta,
        soal: dataSoal
      };

      try {
        const res = await fetch(SCRIPT_URL, {
          method: "POST",
          body: JSON.stringify(payload)
        });
        const data = await res.json();

        if (data.status === "success") {
          document.getElementById('resultLink').classList.remove('hidden');
          document.getElementById('generatedUrl').value = data.studentLink;
          document.getElementById('driveSheetUrl').href = data.sheetUrl;
          
          // Scroll halus ke kotak hasil
          document.getElementById('resultLink').scrollIntoView({ behavior: 'smooth' });
        } else {
          alert("Gagal membuat ujian: " + data.message);
        }
      } catch (err) {
        alert("Terjadi kesalahan koneksi saat membuat Spreadsheet ujian!");
      } finally {
        document.getElementById('loadingIndicator').classList.add('hidden');
        document.getElementById('btnGenerate').disabled = false;
        document.getElementById('btnGenerate').classList.remove('opacity-50');
      }
    }

    // Fungsi Salin Link Siswa
    function copyLink() {
      const copyText = document.getElementById("generatedUrl");
      copyText.select();
      copyText.setSelectionRange(0, 99999);
      navigator.clipboard.writeText(copyText.value);
      alert("Link pengerjaan berhasil disalin!");
    }
  </script>
</body>
</html>
